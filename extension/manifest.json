{
  "manifest_version": 3,
  "name": "Open Campus",
  "version": "0.4.0",
  "description": "Local-first themes, assignments, GPA, notes, study sets and planning. No account or subscription.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "alarms",
    "notifications"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open Campus"
  },
  "options_page": "index.html",
  "web_accessible_resources": [
    {
      "resources": [
        "index.html",
        "src/app.css",
        "src/app.js",
        "src/core.js",
        "src/store.js",
        "src/games.js",
        "src/vendor/*",
        "src/vendor/standard_fonts/*",
        "src/theme-compat.js",
        "src/theme-runtime.js"
      ],
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ],
  "icons": {
    "128": "icons/icon.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.bettercampus.com http://localhost:11434 http://127.0.0.1:11434 http://127.0.0.1:4317 http://localhost:4317; img-src 'self' data: https:; media-src 'self' blob:; worker-src 'self';"
  }
}
